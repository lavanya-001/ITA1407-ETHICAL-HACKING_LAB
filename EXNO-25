1.nano square.sh

paste:#!/bin/bash
read -p "Enter a number: " n
echo "Square = $((n*n))"

chmod +x square.sh
./square.sh


2.nano biggest.sh

paste:#!/bin/bash
read -p "Enter three numbers: " a b c

if [ $a -ge $b ] && [ $a -ge $c ]; then
    echo "Biggest = $a"
elif [ $b -ge $a ] && [ $b -ge $c ]; then
    echo "Biggest = $b"
else
    echo "Biggest = $c"
fi

chmod +x biggest.sh
./biggest.sh
